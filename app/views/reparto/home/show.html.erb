<header class="reparto-header">
  <p class="reparto-kicker">REPARTO DE HOY</p>
  <h1 class="reparto-date"><%= reparto_date(Date.current) %></h1>
  <% if current_user.driver? %><p class="reparto-text">Hola, <%= current_user.display_name %>.</p><% end %>
</header>

<% if @route %>
  <%= render "reparto/routes/route", route: @route, stops: @stops, next_stop: @next %>
<% elsif @routes.present? %>
  <p class="reparto-text">Hoy tenés <strong><%= @routes.size %> repartos</strong>. Tocá el que vas a hacer.</p>
  <% first_open = @routes.find { |r| @stops_by_route.fetch(r.id, []).any? { |s| s.delivery_status == "pending" } } %>
  <% @routes.each do |route| %>
    <% stops = @stops_by_route.fetch(route.id, []) %>
    <%= link_to reparto_route_path(route), class: "reparto-button reparto-button-col#{' reparto-button-primary' if route == first_open}" do %>
      <span><%= route.label.upcase %></span>
      <span class="reparto-sub"><%= stops.size %> parada<%= "s" unless stops.size == 1 %> · <%= route.progress_for(stops) %></span>
    <% end %>
  <% end %>
<% elsif current_user.admin? %>
  <section class="reparto-card">
    <p class="reparto-big">Estás en el portal del repartidor como administrador.</p>
    <p class="reparto-text">Para ver el recorrido de un repartidor sin registrar nada, usá "Ver como repartidor" en Repartos.</p>
  </section>
  <%= link_to "IR A REPARTOS", admin_delivery_routes_path, class: "reparto-button reparto-button-primary" %>
  <%= link_to "PROBAR LA DEMOSTRACIÓN", reparto_prototype_path, class: "reparto-button" %>
<% else %>
  <section class="reparto-card">
    <p class="reparto-big">Hoy no tenés reparto.</p>
    <p class="reparto-text">Cuando administración te asigne un recorrido, va a aparecer acá.</p>
  </section>
<% end %>

<%= render "reparto/home/pending_past" %>

<footer class="reparto-footer">
  <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
        class: "reparto-link-button",
        form: { onsubmit: "return confirm('¿Seguro que querés cerrar la sesión? Vas a tener que escribir el usuario y la contraseña de nuevo.')" } %>
</footer>
