<%= link_to "◀ VOLVER A LA LISTA", reparto_route_stops_path(@route), class: "reparto-back" %>
<header class="reparto-header">
  <p class="reparto-kicker"><%= "#{@route.label.upcase} · " if todays_routes.many? %>PARADA <%= @stop.position %> DE <%= @route.active_stops.count %><%= " · #{@stop.kind_label.upcase}" if @stop.manual? %></p>
  <h1 class="reparto-name"><%= @stop.display_name %></h1>
  <% if @stop.address_line %>
    <p class="reparto-address"><%= @stop.address_line %></p>
  <% else %>
    <p class="reparto-text">No tiene dirección cargada. Si no sabés llegar, llamá a administración.</p>
  <% end %>
</header>

<% if (url = @stop.google_maps_url) %>
  <%= link_to url, class: "reparto-button", target: "_blank", rel: "noopener" do %>📍 CÓMO LLEGAR<% end %>
<% end %>

<% if @stop.instructions %>
  <p class="reparto-note"><strong>Ojo:</strong> <%= @stop.instructions %></p>
<% end %>

<% if @stop.order? %>
  <section class="reparto-card">
    <p class="reparto-kicker">LLEVÁS</p>
    <ul class="reparto-items">
      <% @stop.order.order_items.each do |item| %>
        <li><span class="reparto-qty"><%= item.quantity %></span> <span><%= item.product_name_snapshot %></span></li>
      <% end %>
    </ul>
    <p class="reparto-total"><span>Total del pedido</span> <strong><%= format_money(@stop.order.total_cents) %></strong></p>
  </section>
<% end %>

<% route_open = @route.open_for_driver? %>
<% if !route_open %>
  <p class="reparto-note">Ya enviaste la rendición de este reparto: acá solo se puede mirar.</p>
<% end %>

<% if @stop.order? %>
  <% collections = @stop.collections.includes(:customer_payment).to_a %>
  <% if collections.any? || @stop.payment_report %>
    <section class="reparto-card">
      <p class="reparto-kicker">COBROS</p>
      <% collections.each do |collection| %>
        <div class="reparto-row">
          <span>
            <span class="<%= 'reparto-strike' unless collection.counts? %>"><%= l(collection.created_at, format: "%H:%M") %> · efectivo</span>
            <% if collection.unidentified? %> <span class="reparto-tag">A identificar</span><% end %>
            <% if collection.voided? %> <span class="reparto-tag">Corregido</span><% elsif collection.voided_outside? %> <span class="reparto-tag">Anulado por administración</span><% end %>
          </span>
          <strong class="<%= 'reparto-strike' unless collection.counts? %>"><%= format_money(collection.amount_cents) %></strong>
        </div>
        <% if route_open && collection.counts? %>
          <%= link_to "Corregir este cobro", reparto_collection_correction_path(collection), class: "reparto-link" %>
        <% end %>
      <% end %>
      <% if collections.none?(&:counts?) && @stop.payment_report == "none" %><p class="reparto-text">No te pagaron.</p><% end %>
    </section>
  <% end %>
  <% if @stop.receipt_photo_pending? %>
    <p class="reparto-warning">📷 Falta la foto del remito firmado.</p>
    <%= link_to "📷 SACAR LA FOTO DEL REMITO", reparto_stop_photo_path(@stop), class: "reparto-button" unless @route.confirmed? %>
  <% elsif @stop.photos.any? %>
    <p class="reparto-text">📷 Foto del remito guardada.</p>
  <% elsif @stop.receipt_exception %>
    <p class="reparto-text">📷 <%= @stop.receipt_exception_label %>.</p>
  <% end %>
<% end %>

<% if !route_open %>
<% elsif %w[pending not_delivered].include?(@stop.delivery_status) %>
  <% if @stop.delivery_status == "not_delivered" %>
    <section class="reparto-card"><%= render "reparto/stops/status_chip", stop: @stop %></section>
  <% end %>
  <h2 class="reparto-question"><%= @stop.order? ? (@stop.delivery_status == "not_delivered" ? "¿Al final lo pudiste entregar?" : "¿Pudiste entregar el pedido?") : "¿Lo pudiste hacer?" %></h2>
  <% if @stop.order? %>
    <%= button_to deliver_reparto_stop_path(@stop), method: :post, class: "reparto-button reparto-button-primary", data: { saving: "Guardando…" } do %>✔ SÍ, LO ENTREGUÉ<% end %>
  <% else %>
    <%= button_to done_reparto_stop_path(@stop), method: :post, class: "reparto-button reparto-button-primary", data: { saving: "Guardando…" } do %>✔ SÍ, LISTO<% end %>
  <% end %>
  <% if @stop.delivery_status == "pending" %>
    <%= link_to not_delivered_reparto_stop_path(@stop), class: "reparto-button" do %>✖ <%= @stop.order? ? "NO PUDE ENTREGARLO" : "NO PUDE" %><% end %>
  <% end %>
  <% if @stop.order? && @stop.delivery_status == "not_delivered" %>
    <%= link_to "💵 IGUAL ME PAGARON ALGO", reparto_stop_collection_path(@stop), class: "reparto-button" %>
  <% end %>
<% else %>
  <% if @stop.order? %>
    <%= link_to "💵 REGISTRAR UN COBRO", reparto_stop_collection_path(@stop), class: "reparto-button" %>
  <% end %>
  <section class="reparto-done">
    <div class="reparto-check" aria-hidden="true">✔</div>
    <p class="reparto-big"><%= @stop.order? ? "Entregado" : "Hecho" %> a las <%= l(@stop.delivery_recorded_at, format: "%H:%M") %></p>
    <p class="reparto-text">Si fue un error, avisale a administración.</p>
  </section>
<% end %>
