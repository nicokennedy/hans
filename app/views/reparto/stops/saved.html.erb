<section class="reparto-done" role="status">
  <div class="reparto-check" aria-hidden="true">✔</div>
  <h1 class="reparto-big"><%= params[:ya].present? ? "Ya estaba guardado" : "Listo, quedó guardado" %></h1>
  <p class="reparto-text"><strong><%= @stop.display_name %></strong></p>
  <p class="reparto-text">
    <% if @stop.delivery_status == "delivered" %>
      ✔ Entregaste el pedido<%= " a las #{l(@stop.delivery_recorded_at, format: '%H:%M')}" if @stop.delivery_recorded_at %>.
    <% elsif @stop.delivery_status == "done" %>
      ✔ Hiciste la parada.
    <% elsif @stop.delivery_status == "not_delivered" %>
      ✖ No se pudo: <%= @stop.not_delivered_reason %>.
    <% end %>
  </p>
</section>

<% if @stop.order? %>
  <% counted = @stop.collections.select(&:counts?) %>
  <% if counted.any? %>
    <p class="reparto-text reparto-center">💵 Cobraste <strong><%= format_money(counted.sum(&:amount_cents)) %></strong> en efectivo.</p>
  <% elsif @stop.payment_report == "none" %>
    <p class="reparto-text reparto-center">No te pagaron.</p>
  <% end %>
  <% if @stop.receipt_photo_pending? %>
    <p class="reparto-warning">📷 Falta la foto del remito firmado.</p>
    <%= link_to "📷 SACAR LA FOTO AHORA", reparto_stop_photo_path(@stop), class: "reparto-button" %>
  <% end %>
<% end %>

<% if past_route?(@stop.delivery_route) %>
  <%= link_to "🧾 VOLVER A LA RENDICIÓN DEL #{l(@stop.delivery_route.date, format: '%d/%m')}", reparto_route_settlement_path(@stop.delivery_route), class: "reparto-button reparto-button-primary" %>
  <%= link_to "VOLVER AL INICIO", reparto_root_path, class: "reparto-button" %>
<% elsif @next %>
  <%= link_to reparto_stop_path(@next), class: "reparto-button reparto-button-primary reparto-button-col" do %>
    <span>▶ SIGUIENTE PARADA</span><span class="reparto-sub"><%= @next.display_name %></span>
  <% end %>
<% else %>
  <p class="reparto-big reparto-center">¡Terminaste todas las paradas<%= " de este reparto" if todays_routes.many? %>!</p>
<% end %>
<% unless past_route?(@route) %>
  <%= link_to "VOLVER AL INICIO", route_home_path(@route), class: "reparto-button" %>
  <% if todays_routes.many? %><%= link_to "MIS REPARTOS DE HOY", reparto_root_path, class: "reparto-button" %><% end %>
<% end %>
