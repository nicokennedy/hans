<!DOCTYPE html>
<html lang="es">
  <head>
    <title>HANS · Reparto</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1f1f1f">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" href="/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="HANS">
    <meta name="format-detection" content="telephone=no">

    <%= stylesheet_link_tag "reparto", "data-turbo-track": "reload" %>
  </head>

  <body class="reparto">
    <main class="reparto-main">
      <% if alert.present? %>
        <p class="reparto-message reparto-message-error" role="alert"><%= alert %></p>
      <% end %>
      <% if notice.present? %>
        <p class="reparto-message" role="status"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
    <script>
      // Evita registros duplicados por doble toque: al enviar, el botón queda desactivado y
      // dice "Guardando…". El servidor igual es idempotente (ver DeliveryRoutes::Deliveries).
      document.addEventListener("submit", function (event) {
        var form = event.target;
        if (form.dataset.sent) { event.preventDefault(); return; }
        form.dataset.sent = "1";
        form.querySelectorAll("button, input[type=submit]").forEach(function (button) {
          var label = button.dataset.saving;
          button.disabled = true;
          if (label) { if (button.tagName === "INPUT") { button.value = label; } else { button.textContent = label; } }
        });
      });
      // Si el navegador vuelve a mostrar la página desde su memoria, los botones vuelven a andar.
      window.addEventListener("pageshow", function () {
        document.querySelectorAll("form[data-sent]").forEach(function (form) { delete form.dataset.sent; });
      });
    </script>
  </body>
</html>
