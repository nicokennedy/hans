<%# locals: credit_label (texto de la 3ra fila) %>
<div class="account-preview mt-3 p-3 rounded" id="payment-preview">
  <div class="d-flex justify-content-between"><span><%= local_assigns.fetch(:received_label, "Monto recibido") %></span><strong data-payment-distribution-target="received">$0</strong></div>
  <div class="d-flex justify-content-between"><span>Aplicado a pedidos</span><strong class="text-success" data-payment-distribution-target="applied">$0</strong></div>
  <div class="d-flex justify-content-between"><span><%= credit_label %></span><strong class="text-primary" data-payment-distribution-target="credit">$0</strong></div>
  <div class="d-flex justify-content-between"><span>Saldo pendiente posterior</span><strong class="text-danger" data-payment-distribution-target="pendingAfter">$0</strong></div>
  <div class="small mt-2"><%= local_assigns.fetch(:equation, "Monto recibido − Monto distribuido = Saldo sin aplicar") %></div>
  <div class="small text-danger mt-2" data-payment-distribution-target="errors" hidden></div>
</div>
