<div class="container py-5">
  <h1>Editar preparación</h1>
  <p class="text-muted"><%= @preparation.name %></p>

  <%= render "form" %>

  <% if @preparation.stock_only? %>
    <div class="product-card mt-4">
      <h2 class="h5">Objeto de stock</h2>
      <p class="text-muted mb-2">No tiene receta ni costo. Lo descuentan estos productos al venderse:</p>
      <% if @preparation.product_stock_sources.empty? %>
        <p class="mb-0">Todavía ningún producto está vinculado. Se vinculan desde la pantalla de edición de cada producto.</p>
      <% else %>
        <ul class="mb-0">
          <% @preparation.product_stock_sources.includes(:product).sort_by { |s| s.product.name }.each do |source| %>
            <li><%= link_to source.product.name.strip, edit_admin_product_path(source.product) %> — <%= format_quantity(source.quantity) %> <%= @preparation.yield_unit %> por unidad vendida</li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% else %>
    <%= render "components",
      preparation: @preparation,
      component_costs: @component_costs,
      total_cost_cents: @total_cost_cents,
      unit_cost_cents: @unit_cost_cents,
      cost_calculation_error: @cost_calculation_error,
      raw_material_options: @raw_material_options,
      preparation_options: @preparation_options %>
  <% end %>

  <%= render "admin/stock_items/config", stockable: @preparation %>
</div>
