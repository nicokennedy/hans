<div class="container py-5">

  <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-5">
    <div>
      <h1 class="fw-bold mb-1">
        Producción <%= l(@selected_date, format: "%d/%m") %>
      </h1>

      <div class="text-muted">
        Resumen para fábrica
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <% print_url = public_production_print_url(@selected_date) %>
      <% whatsapp_text = "Hola! Te paso la plantilla de producción del #{l(@selected_date, format: "%d/%m")} para imprimir: #{print_url}" %>
      <% whatsapp_url = whatsapp_link_url(whatsapp_text) %>

      <% if whatsapp_url %>
        <%= link_to "Enviar por WhatsApp",
          whatsapp_url,
          target: "_blank",
          class: "btn btn-success" %>
      <% else %>
        <span class="text-muted small" title="Configurá WHATSAPP_OBRADOR_NUMBER para habilitar este botón">
          Enviar por WhatsApp no disponible
        </span>
      <% end %>

      <%= link_to "← Semana",
        admin_production_index_path,
        class: "btn btn-outline-dark" %>
    </div>
  </div>

  <% if @rows.empty? && @special_items.empty? %>

    <div class="product-card">
      No hay pedidos para esta fecha.
    </div>

  <% else %>

    <div class="product-card production-sheet">
      <div class="table-responsive">

        <table class="production-table align-middle mb-0">

          <thead>
            <tr>
              <th>Producto</th>

              <th class="text-center">
                TOTAL
              </th>

              <% @customers.each do |customer| %>
                <th class="text-center vertical-column">
                  <%= customer %>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody>

            <% @rows.each do |row| %>

              <tr>
                <td class="fw-bold">
                  <%= row[:product_name] %>
                </td>

                <td class="text-center fw-bold">
                  <%= row[:total] %>
                </td>

                <% @customers.each do |customer| %>
                  <td class="text-center">
                    <%= row[:quantities_by_customer][customer].nonzero? %>
                  </td>
                <% end %>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>
    </div>

    <% if @special_items.any? %>
      <div class="product-card mt-4 production-special">
        <h2 class="h5 fw-bold mb-3">PRODUCTOS ESPECIALES — HANS</h2>

        <div class="table-responsive">
          <table class="production-table align-middle mb-0">
            <thead>
              <tr>
                <th>Producto</th>
                <th class="text-center">Cant.</th>
                <th>Comprador</th>
                <th>Horario</th>
                <th>Observaciones</th>
              </tr>
            </thead>
            <tbody>
              <% @special_items.each do |item| %>
                <tr>
                  <td class="fw-bold"><%= item.description %></td>
                  <td class="text-center fw-bold"><%= item.quantity %></td>
                  <td><%= item.buyer_name %> <span class="text-muted small">(<%= item.delivery_kind_label %>)</span></td>
                  <td><%= item.time_note %></td>
                  <td><%= item.notes %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

  <% end %>

  <%# Pedidos de la tienda online pendientes de confirmación: visibles, pero NO incluidos en las cantidades de arriba. %>
  <% if @awaiting_orders.any? %>
    <div class="product-card mt-4 border border-warning" id="production-awaiting">
      <h2 class="h5 fw-bold mb-1">Por confirmar — no incluidos en las cantidades</h2>
      <p class="small text-muted mb-3">Pedidos de la tienda online para esta fecha que todavía no se confirmaron. Al confirmarlos se suman solos a la planilla.</p>
      <ul class="list-unstyled mb-0">
        <% @awaiting_orders.each do |order| %>
          <li class="mb-2">
            <strong><%= current_user.admin? ? link_to(order.number, admin_retail_order_path(order)) : order.number %></strong>
            · <%= order.buyer_name %> <span class="text-muted small">(<%= order.delivery_kind_label %><%= ", #{order.delivery_time_note}" if order.delivery_time_note.present? %>)</span>
            <div class="small text-muted"><%= order.retail_order_items.map { |item| "#{item.quantity} × #{item.display_name}" }.join(" · ") %></div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

</div>
