<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Producción <%= l(@selected_date, format: "%d/%m") %></title>

  <style>
    body {
      background: white;
      margin: 0;
      padding: 12px;
      font-family: Arial, sans-serif;
      color: #111;
    }

    .print-actions {
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
    }

    .print-actions a,
    .print-actions button {
      font-size: 14px;
      padding: 8px 12px;
      border: 1px solid #333;
      background: white;
      color: #111;
      text-decoration: none;
      cursor: pointer;
    }

    .production-date {
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    table {
      border-collapse: collapse;
      font-family: Arial, sans-serif;
      width: max-content;
      min-width: 0;
      table-layout: auto;
    }

    th,
    td {
      border: 1px solid #777;
      padding: 6px 8px;
    }

    thead th {
      background: #bfbfbf;
      font-weight: bold;
      font-size: 12px;
      text-align: center;
    }

    tbody tr:nth-child(even) {
      background: #e9e9e9;
    }

    .product-col {
      text-align: left;
      font-weight: bold;
      font-size: 12px;
      width: 1%;
      white-space: nowrap;
    }

    .total-col {
      width: 74px;
      min-width: 74px;
      max-width: 74px;
      text-align: center;
      font-weight: bold;
    }

    td.total-col {
      font-size: 15px;
    }

    .customer-col {
      width: 74px;
      min-width: 74px;
      max-width: 74px;
      text-align: center;
      font-weight: bold;
    }

    .customer-header {
      vertical-align: middle;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
      padding: 10px 6px;
    }

    .number-cell {
      text-align: center;
      font-size: 15px;
      font-weight: normal;
    }

    @media print {
      @page {
        size: landscape;
        margin: 8mm;
      }

      .print-actions {
        display: none !important;
      }

      body {
        padding: 0;
      }

      th,
      td {
        padding: 5px 6px;
      }
    }

    .production-desktop {
      display: block;
    }

    .production-mobile {
      display: none;
    }

    .mobile-summary {
      margin-bottom: 18px;
    }

    .mobile-summary-title {
      font-size: 22px;
      font-weight: bold;
    }

    .mobile-summary-date {
      font-size: 16px;
      color: #333;
      margin-top: 2px;
    }

    .mobile-summary-count {
      font-size: 14px;
      color: #666;
      margin-top: 2px;
    }

    .mobile-customer-card {
      border: 1px solid #ccc;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 14px;
    }

    .mobile-customer-name {
      font-size: 17px;
      font-weight: bold;
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 2px solid #333;
    }

    .mobile-product-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      padding: 7px 0;
      border-bottom: 1px solid #eee;
    }

    .mobile-product-row:last-child {
      border-bottom: none;
    }

    .mobile-product-name {
      font-size: 15px;
    }

    .mobile-product-qty {
      font-size: 17px;
      font-weight: bold;
      flex-shrink: 0;
    }

    @media screen and (max-width: 767px) {
      .production-desktop {
        display: none;
      }

      .production-mobile {
        display: block;
      }

      .print-actions a,
      .print-actions button {
        flex: 1;
        text-align: center;
        font-size: 16px;
        padding: 14px 12px;
      }
    }
  </style>
</head>

<body>
  <div class="print-actions">
    <%= link_to "← Volver", admin_production_path(@selected_date) %>
    <button onclick="window.print()">Imprimir</button>
  </div>

  <% if @rows.empty? %>
    <p>No hay pedidos para esta fecha.</p>
  <% else %>
    <div class="production-desktop">
      <div class="production-date">
        <%= l(@selected_date, format: "%d/%m/%Y") %>
      </div>

      <table>
        <thead>
          <tr>
            <th class="product-col"></th>
            <th class="total-col">TOTAL</th>

            <% @customers.each do |customer| %>
              <th class="customer-col customer-header">
                <%= customer.name %>
              </th>
            <% end %>
          </tr>
        </thead>

        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="product-col">
                <%= row[:product_name] %>
              </td>

              <td class="total-col">
                <%= row[:total] %>
              </td>

              <% @customers.each do |customer| %>
                <td class="number-cell">
                  <%= row[:quantities_by_customer][customer.name].nonzero? %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="production-mobile">
      <div class="mobile-summary">
        <div class="mobile-summary-title">Producción</div>
        <div class="mobile-summary-date"><%= l(@selected_date, format: "%d/%m/%Y") %></div>
        <div class="mobile-summary-count"><%= pluralize(@customers.size, "cliente", "clientes") %></div>
      </div>

      <% @customers.each do |customer| %>
        <div class="mobile-customer-card">
          <div class="mobile-customer-name"><%= customer.name %></div>

          <% @rows.each do |row| %>
            <% quantity = row[:quantities_by_customer][customer.name].to_i %>
            <% next unless quantity > 0 %>
            <div class="mobile-product-row">
              <span class="mobile-product-name"><%= row[:product_name] %></span>
              <span class="mobile-product-qty"><%= quantity %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</body>
</html>
