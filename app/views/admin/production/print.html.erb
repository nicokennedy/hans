<!DOCTYPE html>
<html>
<head>
  <title>Producción <%= l(@selected_date, format: "%d/%m") %></title>

  <style>
    body {
      background: white;
      margin: 0;
      padding: 12px;
      font-family: Arial, sans-serif;
      color: #111;
    }

    .print-actions {
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
    }

    .print-actions a,
    .print-actions button {
      font-size: 14px;
      padding: 8px 12px;
      border: 1px solid #333;
      background: white;
      color: #111;
      text-decoration: none;
      cursor: pointer;
    }

    .production-date {
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    table {
      border-collapse: collapse;
      font-family: Arial, sans-serif;
      width: max-content;
      min-width: 0;
      table-layout: auto;
    }

    th,
    td {
      border: 1px solid #777;
      padding: 6px 8px;
    }

    thead th {
      background: #bfbfbf;
      font-weight: bold;
      font-size: 12px;
      text-align: center;
    }

    tbody tr:nth-child(even) {
      background: #e9e9e9;
    }

    .product-col {
      text-align: left;
      font-weight: bold;
      font-size: 12px;
      width: 1%;
      white-space: nowrap;
    }

    .total-col {
      width: 74px;
      min-width: 74px;
      max-width: 74px;
      text-align: center;
      font-weight: bold;
    }

    td.total-col {
      font-size: 15px;
    }

    .customer-col {
      width: 74px;
      min-width: 74px;
      max-width: 74px;
      text-align: center;
      font-weight: bold;
    }

    .customer-header {
      vertical-align: middle;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
      padding: 10px 6px;
    }

    .number-cell {
      text-align: center;
      font-size: 15px;
      font-weight: normal;
    }

    .special-title {
      margin-top: 18px;
      margin-bottom: 4px;
      font-size: 13px;
      font-weight: bold;
    }

    .special-table td.left-cell {
      text-align: left;
      font-size: 12px;
      white-space: normal;
      max-width: 260px;
    }

    @media print {
      @page {
        size: landscape;
        margin: 8mm;
      }

      .print-actions {
        display: none !important;
      }

      body {
        padding: 0;
      }

      th,
      td {
        padding: 5px 6px;
      }
    }
  </style>
</head>

<body>
  <div class="print-actions">
    <%= link_to "← Volver", admin_production_path(@selected_date) %>
    <button onclick="window.print()">Imprimir</button>
  </div>

  <div class="production-date">
    <%= l(@selected_date, format: "%d/%m/%Y") %>
  </div>

  <% if @rows.empty? && @special_items.empty? %>
    <p>No hay pedidos para esta fecha.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th class="product-col"></th>
          <th class="total-col">TOTAL</th>

          <% @customers.each do |customer| %>
            <th class="customer-col customer-header">
              <%= customer %>
            </th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td class="product-col">
              <%= row[:product_name] %>
            </td>

            <td class="total-col">
              <%= row[:total] %>
            </td>

            <% @customers.each do |customer| %>
              <td class="number-cell">
                <%= row[:quantities_by_customer][customer].nonzero? %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @special_items.any? %>
      <div class="special-title">PRODUCTOS ESPECIALES — HANS</div>
      <table class="special-table">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Cant.</th>
            <th>Comprador</th>
            <th>Horario</th>
            <th>Observaciones</th>
          </tr>
        </thead>
        <tbody>
          <% @special_items.each do |item| %>
            <tr>
              <td class="product-col"><%= item.description %></td>
              <td class="total-col"><%= item.quantity %></td>
              <td class="left-cell"><%= item.buyer_name %> (<%= item.delivery_kind_label %>)</td>
              <td class="left-cell"><%= item.time_note %></td>
              <td class="left-cell"><%= item.notes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</body>
</html>