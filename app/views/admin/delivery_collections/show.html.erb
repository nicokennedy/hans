<div class="container py-4" style="max-width: 760px">
  <p><%= link_to "← #{@route.title}", admin_delivery_route_path(@route, anchor: "rendicion") %></p>
  <h1 class="h3">Detalle del cobro</h1>
  <div class="product-card">
    <p><strong><%= @collection.customer.name %></strong> · <%= reparto_money(@collection.amount_cents) %></p>
    <p><%= @collection.created_by.display_name %> · <%= l(@collection.created_at, format: "%d/%m %H:%M") %></p>
    <% if @collection.voided? %><p>Anulado. <%= @collection.void_reason %></p><% end %>
    <%= link_to "Ver en cuenta corriente", admin_customer_account_path(@collection.customer_id, anchor: "customer-payment-#{@collection.customer_payment_id}") %>
    <% if @collection.evidence.attached? %>
      <p class="mt-3"><%= link_to "Ver foto del cobro", delivery_collection_evidence_path(@collection), class: "btn btn-outline-dark" %></p>
    <% end %>
  </div>
</div>
