<div class="container py-5">
  <div class="d-flex gap-2 mb-4">
    <%= link_to "← Volver al pedido", admin_order_path(@order), class: "btn btn-outline-dark" %>
  </div>

  <div class="product-card">
    <h1 class="fw-bold mb-2">Editar pedido <%= @order.number %></h1>
    <div class="text-muted mb-4"><%= @order.customer.name %></div>

    <% if @order.errors.any? %>
      <div class="alert alert-danger">
        <%= @order.errors.full_messages.join(", ") %>
      </div>
    <% end %>

    <%= form_with model: [:admin, @order], local: true, data: { controller: "order-items" } do |f| %>
      <div class="mb-3">
        <%= f.label :delivery_date, "Fecha de entrega", class: "form-label" %>
        <%= f.date_field :delivery_date, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :status, "Estado", class: "form-label" %>
        <%= f.select :status,
          Order.statuses.keys.map { |status| [status.humanize, status] },
          {},
          class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :payment_method_selected, "Método de pago", class: "form-label" %>
        <%= f.select :payment_method_selected,
          Order.payment_method_options_for_select,
          { include_blank: "Sin definir" },
          class: "form-select" %>
      </div>

      <div class="mb-4">
        <%= f.label :customer_comment, "Comentario", class: "form-label" %>
        <%= f.text_area :customer_comment, rows: 3, class: "form-control" %>
      </div>

      <h4 class="mb-3">Productos del pedido</h4>

      <% only_item = @order.order_items.size <= 1 %>
      <% @order.order_items.each do |item| %>
        <div class="d-flex justify-content-between align-items-center border-bottom py-3">
          <div style="width: 220px;">
            <label class="form-label small">Producto</label>
            <%= select_tag "order_items[#{item.id}][product_id]",
                order_item_product_options(item, @products),
                class: "form-select form-select-sm" %>
          </div>

          <div style="width: 140px;">
            <label class="form-label small">Cantidad</label>

            <%= number_field_tag "order_items[#{item.id}][quantity]",
                item.quantity,
                min: 1,
                class: "form-control mb-2" %>

            <div class="form-check">
              <%= check_box_tag "order_items[#{item.id}][remove]",
                  "1",
                  false,
                  class: "form-check-input",
                  disabled: only_item %>

              <label class="form-check-label">
                Eliminar
              </label>
              <% if only_item %>
                <div class="form-text">No se puede eliminar el último producto.</div>
              <% end %>
            </div>
          </div>

          <div style="width: 140px;">
            <label class="form-label small">Precio unitario</label>
            <%= number_field_tag "order_items[#{item.id}][unit_price_amount]",
                item.unit_price_amount,
                min: 0,
                class: "form-control" %>
          </div>

          <div class="fw-bold">
            $<%= number_with_delimiter(item.line_revenue_cents / 100) %>
          </div>
        </div>
      <% end %>

      <div data-order-items-target="list"></div>

      <template data-order-items-target="template">
        <%= render "order_item_fields", item: OrderItem.new, products: @products, field_prefix: "new_order_items" %>
      </template>

      <div class="form-text mb-3">Las líneas nuevas se agregan al guardar. Si un producto agregado ya está en el pedido, se suma la cantidad a la línea existente en vez de duplicarla.</div>

      <div class="mt-3 mb-4 d-flex gap-2">
        <button type="button" class="btn btn-outline-dark" data-action="order-items#add">Agregar otra línea</button>
      </div>

      <div class="mt-4">
        <%= f.submit "Guardar cambios", class: "btn btn-dark" %>
      </div>
    <% end %>
  </div>
</div>