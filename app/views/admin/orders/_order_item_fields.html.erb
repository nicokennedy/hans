<% field_prefix ||= "order_items" %>
<div class="d-flex justify-content-between align-items-center border-bottom py-3 order-item-row">
  <div style="width: 220px;">
    <label class="form-label small">Producto</label>
    <%= select_tag "#{field_prefix}[][product_id]",
        options_for_select(
          products.map { |p| [ p.name, p.id, { "data-price-amount": p.price_amount } ] },
          item.product_id
        ),
        include_blank: "Seleccionar producto",
        class: "form-select form-select-sm",
        data: { action: "change->order-items#fillPrice" } %>
  </div>

  <div style="width: 140px;">
    <label class="form-label small">Cantidad</label>
    <%= number_field_tag "#{field_prefix}[][quantity]",
        item.quantity || 1,
        min: 1,
        class: "form-control" %>
  </div>

  <div style="width: 140px;">
    <label class="form-label small">Precio unitario</label>
    <%= number_field_tag "#{field_prefix}[][unit_price_amount]",
        item.unit_price_cents_snapshot ? item.unit_price_amount : nil,
        min: 0,
        class: "form-control unit-price-input",
        placeholder: "Precio de lista" %>
  </div>
</div>
