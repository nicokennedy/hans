<div class="container py-5">
  <h1>Editar receta</h1>
  <p class="text-muted">
    <%= @product.name %> &middot;
    Fuente de costo: <%= @product.recipe? ? "Receta (activa)" : "Manual (borrador)" %> &middot;
    Costo actual del producto: <%= format_money(@product.cost_cents) %>
  </p>

  <%= render "form" %>

  <%= render "components",
    product: @product,
    product_recipe: @product_recipe,
    component_costs: @component_costs,
    total_cost_cents: @total_cost_cents,
    unit_cost_cents: @unit_cost_cents,
    cost_calculation_error: @cost_calculation_error,
    raw_material_options: @raw_material_options,
    preparation_options: @preparation_options %>

  <p class="mt-3">
    <%= link_to "Volver al producto", edit_admin_product_path(@product), class: "btn btn-outline-dark" %>
  </p>
</div>
