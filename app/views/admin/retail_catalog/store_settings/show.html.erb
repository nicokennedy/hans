<div class="container py-5">
  <div class="mb-3">
    <div class="text-muted small">Tienda Minorista</div>
    <h1 class="fw-bold mb-0">Tienda online</h1>
    <div class="text-muted small">Publicación de la tienda pública, portada, WhatsApp de HANS y datos para transferencia.</div>
  </div>
  <%= render "admin/retail_catalog/shared/nav" %>

  <div class="product-card mb-4" id="store-publication">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <h2 class="fs-5 fw-bold mb-1">Publicación</h2>
        <% if @setting.published? %>
          <span class="badge bg-success fs-6" id="store-status">Publicada</span>
          <div class="small text-muted mt-1">Cualquier persona puede ver la tienda y hacer pedidos<% if @setting.published_at %> (desde el <%= l(@setting.published_at.in_time_zone(RetailFulfillment::TIME_ZONE), format: "%d/%m/%Y %H:%M") %>)<% end %>.</div>
        <% else %>
          <span class="badge bg-secondary fs-6" id="store-status">Cerrada al público</span>
          <div class="small text-muted mt-1">El público ve “Próximamente”. Los administradores la recorren en <strong>vista previa</strong>: el checkout valida todo y muestra el mensaje de WhatsApp, pero <strong>no registra pedidos</strong>.</div>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to (@setting.published? ? "Abrir la tienda" : "Ver la tienda (vista previa)"), store_root_path, class: "btn btn-outline-dark", target: "_blank", rel: "noopener", id: "store-open-link" %>
      </div>
    </div>

    <div class="mt-3 small">
      <div class="text-muted">Dirección de la tienda</div>
      <code id="store-url"><%= store_root_url %></code>
    </div>

    <hr>
    <h3 class="fs-6 fw-bold">Antes de publicar</h3>
    <ul class="small mb-3" id="store-readiness">
      <li><strong><%= @published_products %></strong> <%= @published_products == 1 ? "producto visible" : "productos visibles" %> en la tienda (de <%= @active_products %> activos). Se muestran los activos, de categoría activa y con foto principal.</li>
      <li><strong><%= @active_zones %></strong> <%= @active_zones == 1 ? "zona de envío activa" : "zonas de envío activas" %>.</li>
      <li>Punto de retiro: <%= @pickup_details.present? ? "cargado" : content_tag(:span, "sin cargar (se coordina por WhatsApp)", class: "text-warning-emphasis") %> — <%= link_to "Entregas", admin_retail_catalog_fulfillment_path %>.</li>
      <li>Datos para transferencia: <%= @setting.bank_transfer_details.present? ? "cargados" : content_tag(:span, "sin cargar (se pasan por WhatsApp)", class: "text-warning-emphasis") %>.</li>
      <li>Probá el recorrido completo en vista previa: catálogo, carrito, checkout con retiro y con envío, y el mensaje de WhatsApp.</li>
    </ul>

    <% if @setting.published? %>
      <%= button_to "Cerrar la tienda al público", unpublish_admin_retail_catalog_store_settings_path, method: :patch, class: "btn btn-outline-danger",
            form: { data: { turbo_confirm: "¿Cerrar la tienda? El público verá “Próximamente” y no podrá hacer pedidos. Los pedidos ya hechos no cambian." } } %>
    <% else %>
      <%= form_with url: publish_admin_retail_catalog_store_settings_path, method: :patch, local: true, id: "store-publish-form",
            data: { turbo_confirm: "¿Publicar la tienda? Desde ahora cualquier persona podrá hacer pedidos." } do %>
        <div class="form-check mb-2">
          <%= check_box_tag :confirm, "1", false, class: "form-check-input", id: "store-publish-confirm", required: true %>
          <label class="form-check-label" for="store-publish-confirm">Revisé la tienda en vista previa y quiero abrirla al público.</label>
        </div>
        <%= submit_tag "Publicar la tienda", class: "btn btn-success" %>
      <% end %>
    <% end %>
  </div>

  <div class="product-card mb-4" id="store-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
      <div>
        <h2 class="fs-5 fw-bold mb-1">Portada de la tienda</h2>
        <div class="small text-muted">Lo primero que ve el cliente. Cambiala para campañas (Navidad, Pascuas, Día de la Madre) sin tocar código.</div>
      </div>
      <%= link_to "Ver la portada", store_root_path, class: "btn btn-sm btn-outline-dark", target: "_blank", rel: "noopener", id: "store-hero-open" %>
    </div>
    <%= render "admin/administration/shared/errors", errors: @hero_errors %>

    <div class="row g-4">
      <div class="col-12 col-lg-4">
        <div class="small fw-semibold mb-2">Foto de portada</div>
        <% if @setting.hero_image? %>
          <div class="rounded-3 overflow-hidden border mb-2" style="aspect-ratio: 4 / 5; background: #f4ede2;">
            <%= image_tag rails_storage_proxy_path(@setting.hero_image.variant(:hero_sm)), alt: @setting.hero_image_alt.to_s, id: "store-hero-current",
                  style: "width: 100%; height: 100%; object-fit: cover; object-position: #{@setting.hero_image_position};" %>
          </div>
          <div class="small text-muted mb-2" id="store-hero-mode">Se muestra esta foto (recortada al marco en arco, encuadre: <%= RetailStoreSetting::HERO_POSITIONS[@setting.hero_image_position].downcase %>).</div>
          <%= button_to "Quitar la foto de portada", hero_image_admin_retail_catalog_store_settings_path, method: :delete, class: "btn btn-sm btn-outline-danger", id: "store-hero-remove",
                form: { data: { turbo_confirm: "¿Quitar la foto de portada? La tienda vuelve a mostrar la composición con fotos de productos." } } %>
        <% else %>
          <div class="rounded-3 border d-flex align-items-center justify-content-center text-center p-3 mb-2 small text-muted" style="aspect-ratio: 4 / 5; background: #f4ede2; border-style: dashed !important;" id="store-hero-mode">
            Sin foto de portada.<br>La tienda arma la portada sola con las fotos de los productos destacados.
          </div>
        <% end %>
      </div>

      <div class="col-12 col-lg-8">
        <%= form_with url: hero_admin_retail_catalog_store_settings_path, method: :patch, local: true, multipart: true, id: "store-hero-form" do %>
          <div class="mb-3">
            <label class="form-label" for="hero_title">Título</label>
            <%= text_area_tag :hero_title, @setting.hero_title, class: "form-control", rows: 2, maxlength: RetailStoreSetting::HERO_TITLE_MAX,
                  placeholder: RetailStoreSetting::DEFAULT_HERO_TITLE %>
            <div class="form-text">Hasta <%= RetailStoreSetting::HERO_TITLE_MAX %> caracteres. Con <kbd>Enter</kbd> pasás a una segunda línea, que se muestra en itálica y color de acento. Vacío: “<%= RetailStoreSetting::DEFAULT_HERO_TITLE.tr("\n", " ") %>”.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="hero_subtitle">Subtítulo</label>
            <%= text_area_tag :hero_subtitle, @setting.hero_subtitle, class: "form-control", rows: 3, maxlength: RetailStoreSetting::HERO_SUBTITLE_MAX,
                  placeholder: RetailStoreSetting::DEFAULT_HERO_SUBTITLE %>
            <div class="form-text">Una o dos frases cortas (hasta <%= RetailStoreSetting::HERO_SUBTITLE_MAX %> caracteres). Vacío: se usa el texto por defecto. El botón “Explorar productos” se muestra siempre.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="hero_image"><%= @setting.hero_image? ? "Reemplazar la foto" : "Subir una foto" %></label>
            <%= file_field_tag :hero_image, class: "form-control", accept: "image/jpeg,image/png,image/webp" %>
            <div class="form-text">JPEG, PNG o WebP de hasta 10 MB. Ideal: vertical (4:5), de al menos 1200 px de ancho, con el producto centrado. La tienda la optimiza sola.</div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-8">
              <label class="form-label" for="hero_image_alt">Descripción de la foto</label>
              <%= text_field_tag :hero_image_alt, @setting.hero_image_alt, class: "form-control", maxlength: 150, placeholder: "Ej. Torta de Navidad con frutos rojos" %>
              <div class="form-text">Para lectores de pantalla y buscadores.</div>
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label" for="hero_image_position">Encuadre</label>
              <%= select_tag :hero_image_position, options_for_select(RetailStoreSetting::HERO_POSITIONS.invert, @setting.hero_image_position), class: "form-select" %>
              <div class="form-text">Qué parte conservar al recortar.</div>
            </div>
          </div>
          <%= submit_tag "Guardar portada", class: "btn btn-dark", data: { turbo_submits_with: "Guardando…" } %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="product-card mb-4" id="store-data">
    <h2 class="fs-5 fw-bold mb-3">WhatsApp y transferencia</h2>
    <%= render "admin/administration/shared/errors", errors: @errors %>
    <%= form_with url: admin_retail_catalog_store_settings_path, method: :patch, local: true do %>
      <div class="row g-3">
        <div class="col-12 col-md-5">
          <label class="form-label" for="whatsapp_number">WhatsApp de HANS (para wa.me) *</label>
          <%= text_field_tag :whatsapp_number, @setting.whatsapp_number, class: "form-control", required: true, maxlength: 20, inputmode: "numeric" %>
          <div class="form-text">Solo números, con código de país y sin el 0 ni el 15: <code>5492235275412</code>. Se muestra como <strong><%= @setting.whatsapp_display %></strong>.</div>
        </div>
        <div class="col-12 col-md-7">
          <label class="form-label" for="bank_transfer_details">Datos para transferencia</label>
          <%= text_area_tag :bank_transfer_details, @setting.bank_transfer_details, class: "form-control", rows: 4, maxlength: 1000, placeholder: "Titular, CBU/CVU y alias. Si queda vacío, el cliente ve que los datos se pasan por WhatsApp." %>
          <div class="form-text">Los ve el cliente que elige transferencia, en la pantalla de pedido recibido.</div>
        </div>
      </div>
      <%= submit_tag "Guardar", class: "btn btn-dark mt-3" %>
    <% end %>
  </div>

  <div class="product-card mb-4">
    <h2 class="fs-5 fw-bold mb-2">Cómo llegan los pedidos</h2>
    <p class="small mb-1">Cada pedido de la tienda aparece en <%= link_to "Pedidos Minoristas", admin_retail_orders_path %> como <strong>Tienda online · Pendiente de confirmación</strong> (hoy: <strong id="store-awaiting-count"><%= @awaiting_orders %></strong>). No cuenta para producción ni stock hasta que lo confirmás. El cliente además te escribe por WhatsApp con el número de pedido.</p>
    <p class="small mb-0 text-muted">Abrir WhatsApp no confirma ni paga nada: la confirmación y los pagos se registran desde el pedido.</p>
  </div>
</div>
