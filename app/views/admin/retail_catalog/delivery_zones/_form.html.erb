<%# locals: url, method, submit_label %>
<%= render "admin/administration/shared/errors", errors: @zone.errors.full_messages %>
<%= form_with model: @zone, scope: :retail_delivery_zone, url: url, method: method, local: true do |f| %>
  <div class="product-card mb-4"><div class="row g-3">
    <div class="col-12 col-md-4"><%= f.label :name, "Nombre *", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true, maxlength: 60, placeholder: "Ej.: Zona 4" %></div>
    <div class="col-6 col-md-4"><%= f.label :price, "Costo de envío ($) *", class: "form-label" %><%= f.text_field :price, class: "form-control", required: true, inputmode: "decimal", placeholder: "Ej.: 5.000 (0 = gratis)" %></div>
    <div class="col-6 col-md-2"><%= f.label :position, "Orden", class: "form-label" %><%= f.number_field :position, class: "form-control" %></div>
    <div class="col-12 col-md-2 d-flex align-items-end"><div class="form-check"><%= f.check_box :active, class: "form-check-input" %><%= f.label :active, "Activa", class: "form-check-label" %></div></div>
    <div class="col-12">
      <%= f.label :coverage, "Cobertura (orientativa)", class: "form-label" %>
      <%= f.text_field :coverage, class: "form-control", maxlength: 300, placeholder: "Barrios o referencias que ayudan al cliente a elegir su zona" %>
      <div class="form-text">Es un texto de ayuda: el cliente elige su zona a mano y no se valida la dirección.</div>
    </div>
  </div></div>
  <% if @zone.persisted? %>
    <div class="alert alert-light border small">Cambiar el costo afecta solo a los pedidos nuevos: los pedidos ya creados conservan el costo que se les aplicó.</div>
  <% end %>
  <div class="d-flex gap-2"><%= f.submit submit_label, class: "btn btn-dark" %><%= link_to "Cancelar", admin_retail_catalog_fulfillment_path(anchor: "zonas"), class: "btn btn-outline-dark" %></div>
<% end %>
