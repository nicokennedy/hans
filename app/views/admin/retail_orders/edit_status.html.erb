<div class="container py-5" style="max-width: 640px">
  <h1 class="fw-bold mb-1">Cambiar estado</h1>
  <div class="text-muted mb-4"><%= @order.number %> — <%= @order.buyer_name %> · Estado actual: <%= retail_status_badge(@order) %></div>

  <%= render "admin/administration/shared/errors", errors: @errors %>
  <div class="product-card">
    <%= form_with url: status_admin_retail_order_path(@order), method: :patch, local: true do %>
      <% retail_context.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="mb-3">
        <label class="form-label" for="to_status">Nuevo estado</label>
        <%= select_tag :to_status, options_for_select(retail_status_options, params[:to_status].presence || @order.status), class: "form-select" %>
        <div class="form-text">El estado del pedido es independiente del estado de pago. “Cancelado” lo saca de producción y devuelve el stock si ya se había descontado.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="note">Nota (opcional)</label>
        <%= text_field_tag :note, params[:note], class: "form-control", maxlength: 300 %>
      </div>
      <div class="d-flex gap-2">
        <%= submit_tag "Guardar estado", class: "btn btn-dark", data: { disable_with: "Guardando…" } %>
        <%= link_to "Volver", admin_retail_order_path(@order, retail_context), class: "btn btn-outline-dark" %>
      </div>
    <% end %>
  </div>
</div>
