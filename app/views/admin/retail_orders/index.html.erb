<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="fw-bold mb-0">Pedidos Minoristas</h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Exportar Excel", export_admin_retail_orders_path(retail_context.except(:page)), class: "btn btn-outline-dark btn-lg", id: "export-retail-xlsx", title: "Descarga los pedidos con los filtros aplicados" %>
      <%= link_to "+ Nuevo pedido minorista", new_admin_retail_order_path(retail_context), class: "btn btn-dark btn-lg", id: "new-retail-order" %>
    </div>
  </div>

  <div class="product-card mb-4" id="retail-filters">
    <%= form_with url: admin_retail_orders_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
      <div class="col-6 col-md-2"><label class="form-label small mb-0" for="f-from">Entrega desde</label><%= date_field_tag :date_from, @filters.date_from&.iso8601, id: "f-from", class: "form-control form-control-sm" %></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0" for="f-to">Hasta</label><%= date_field_tag :date_to, @filters.date_to&.iso8601, id: "f-to", class: "form-control form-control-sm" %></div>
      <div class="col-12 col-md-2"><label class="form-label small mb-0" for="f-buyer">Comprador</label><%= text_field_tag :buyer, @filters.buyer, id: "f-buyer", class: "form-control form-control-sm", placeholder: "Nombre" %></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0" for="f-kind">Tipo de entrega</label>
        <%= select_tag :kind, options_for_select(retail_delivery_kind_options, @filters.delivery_kind), include_blank: "Todos", id: "f-kind", class: "form-select form-select-sm" %></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0" for="f-status">Estado del pedido</label>
        <%= select_tag :status, options_for_select(retail_status_options, @filters.status), include_blank: "Todos", id: "f-status", class: "form-select form-select-sm" %></div>
      <div class="col-6 col-md-1"><label class="form-label small mb-0" for="f-pay">Pago</label>
        <%= select_tag :payment_status, options_for_select(retail_payment_status_options, @filters.payment_status), include_blank: "Todos", id: "f-pay", class: "form-select form-select-sm" %></div>
      <div class="col-6 col-md-1 d-flex gap-1"><%= submit_tag "Filtrar", name: nil, class: "btn btn-sm btn-dark" %><%= link_to "✕", admin_retail_orders_path, class: "btn btn-sm btn-outline-dark", title: "Limpiar filtros" %></div>
    <% end %>
    <div class="form-text">Con solo “desde” se muestra ese día; con “desde” y “hasta”, el rango.</div>
  </div>

  <div class="small text-muted mb-2"><%= @filters.total_count %> pedidos · ordenados por entrega más cercana</div>

  <div class="product-card">
    <% if @orders.empty? %>
      <div class="text-muted">No hay pedidos minoristas que coincidan.</div>
    <% else %>
      <div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>N°</th><th>Creado</th><th>Entrega</th><th>Horario</th><th>Comprador</th><th>Teléfono</th><th>Tipo</th><th class="text-end">Total</th><th class="text-end">Pagado</th><th class="text-end">Saldo</th><th>Pedido</th><th>Pago</th><th></th></tr></thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="<%= 'text-muted' if order.canceled? %>">
              <td><%= link_to order.number, admin_retail_order_path(order, retail_context) %></td>
              <td><%= retail_date(order.created_at.to_date) %></td>
              <td class="fw-bold"><%= retail_date(order.delivery_date) %></td>
              <td><%= order.delivery_time_note %></td>
              <td class="fw-bold"><%= order.buyer_name %></td>
              <td><%= retail_whatsapp_link(order) %></td>
              <td><%= order.delivery_kind_label %></td>
              <td class="text-end"><%= retail_money(order.total_cents) %></td>
              <td class="text-end text-success"><%= retail_money(order.amount_paid_cents) %></td>
              <td class="text-end <%= order.pending_balance_cents.positive? && !order.canceled? ? 'text-danger fw-bold' : '' %>"><%= retail_money(order.balance_cents) %></td>
              <td><%= retail_status_badge(order) %></td>
              <td><%= retail_payment_badge(order) %></td>
              <td class="text-end text-nowrap">
                <%= link_to "Ver", admin_retail_order_path(order, retail_context), class: "btn btn-sm btn-outline-dark" %>
                <%= link_to "Editar", edit_admin_retail_order_path(order, retail_context), class: "btn btn-sm btn-outline-dark" %>
                <% unless order.canceled? %><%= link_to "Registrar pago", new_admin_retail_order_payment_path(order, retail_context), class: "btn btn-sm btn-dark" %><% end %>
                <%= link_to "Cambiar estado", status_admin_retail_order_path(order, retail_context), class: "btn btn-sm btn-outline-dark" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
      <% if @filters.total_pages > 1 %>
        <nav class="d-flex justify-content-between align-items-center mt-3" id="pagination">
          <%= @filters.page > 1 ? link_to("← Anteriores", retail_list_path(page: @filters.page - 1), class: "btn btn-sm btn-outline-dark") : content_tag(:span) %>
          <span class="small text-muted">Página <%= @filters.page %> de <%= @filters.total_pages %></span>
          <%= @filters.page < @filters.total_pages ? link_to("Siguientes →", retail_list_path(page: @filters.page + 1), class: "btn btn-sm btn-outline-dark") : content_tag(:span) %>
        </nav>
      <% end %>
    <% end %>
  </div>
</div>
