<%# locals: owner %>
<div class="product-card mb-4" id="attachments">
  <h2 class="fs-5 fw-bold mb-3">Comprobantes adjuntos</h2>
  <% attachments = owner.attachments.to_a %>
  <% if attachments.empty? %>
    <div class="text-muted small">No hay archivos adjuntos.</div>
  <% end %>
  <ul class="list-unstyled mb-0">
    <% attachments.each do |attachment| %>
      <li><%= link_to attachment.filename, admin_administration_attachment_path(attachment), target: "_blank", rel: "noopener" %>
        <span class="text-muted small">(<%= number_to_human_size(attachment.byte_size) %> · <%= attachment.created_at.strftime("%d/%m/%Y") %>)</span>
        <%= link_to "Descargar", admin_administration_attachment_path(attachment, download: 1), class: "small" %></li>
    <% end %>
  </ul>
</div>
