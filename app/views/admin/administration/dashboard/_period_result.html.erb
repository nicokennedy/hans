<%# Ventas, resultado económico simplificado y flujo de caja del período (Finance::PeriodResult). %>
<% wholesale = result.wholesale %>
<% retail = result.retail %>
<% pending_label = result.open_period? ? "Pendiente a hoy" : "Pendiente al cierre" %>

<h2 class="fs-5 fw-bold mb-3">Ventas (<%= summary.period_label %>)</h2>
<div class="row g-3 mb-2" id="sales-kpis">
  <% [["wholesale", "Mayoristas", wholesale, "Pedidos", admin_orders_path], ["retail", "Minoristas", retail, "Pedidos Minoristas", admin_retail_orders_path]].each do |key, label, sales, list_label, list_path| %>
    <div class="col-12 col-lg-6">
      <div class="product-card h-100 finance-sales-card" id="sales-<%= key %>">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
          <h3 class="fs-6 fw-bold mb-0"><%= label %></h3>
          <span class="small text-muted"><span id="sales-<%= key %>-count"><%= sales.orders_count %></span> <%= sales.orders_count == 1 ? "pedido" : "pedidos" %></span>
        </div>
        <div class="row g-2">
          <div class="col-4">
            <div class="small text-muted">Facturado</div>
            <div class="fs-5 fw-bold" id="sales-<%= key %>-invoiced"><%= fin_money(sales.invoiced_cents) %></div>
            <div class="small text-muted">por fecha de entrega</div>
          </div>
          <div class="col-4">
            <div class="small text-muted">Cobrado</div>
            <div class="fs-5 fw-bold text-success" id="sales-<%= key %>-collected"><%= fin_money(sales.collected_cents) %></div>
            <div class="small text-muted">por fecha de pago</div>
          </div>
          <div class="col-4">
            <div class="small text-muted"><%= pending_label %></div>
            <div class="fs-5 fw-bold <%= sales.pending_at_close_cents.positive? ? 'text-danger' : 'text-muted' %>" id="sales-<%= key %>-pending"><%= fin_money(sales.pending_at_close_cents) %></div>
            <div class="small text-muted">de estos pedidos</div>
          </div>
        </div>
        <% excluded = [] %>
        <% excluded << "#{sales.canceled_count} cancelado#{'s' unless sales.canceled_count == 1}" if sales.canceled_count.positive? %>
        <% excluded << "#{sales.unconfirmed_count} sin confirmar o rechazado#{'s' unless sales.unconfirmed_count == 1}" if sales.unconfirmed_count.positive? %>
        <div class="small text-muted mt-2">
          <% if excluded.any? %>Fuera del facturado: <%= excluded.join(" y ") %>. <% end %>
          <%= link_to "Ver #{list_label}", list_path, class: "text-decoration-none" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
<div class="small text-muted mb-4">
  <strong>Facturado</strong>: pedidos con entrega en el período, con el mismo criterio que los resúmenes de Pedidos y Pedidos Minoristas (sin cancelados; minoristas solo confirmados; totales con descuentos y envío).
  <strong>Cobrado</strong>: ingresos reales por fecha de pago, aunque el pedido sea de otro mes; cada pago una vez (un pago de cuenta corriente cuenta completo, no sus imputaciones) y sin pagos anulados.
  <strong><%= pending_label %></strong>: saldo de los pedidos del período descontando los pagos hechos hasta <%= result.open_period? ? "hoy" : "el último día del período" %>.
</div>

<div class="row g-4 mb-4">
  <div class="col-12 col-lg-6">
    <div class="product-card h-100 finance-highlight" id="economic-result">
      <h2 class="fs-5 fw-bold mb-1">Resultado económico</h2>
      <div class="small text-muted mb-3">Simplificado — <%= summary.period_label %></div>
      <table class="table table-sm align-middle mb-2 finance-statement">
        <tbody>
          <tr><td class="text-muted" style="width:2.5rem">(+)</td><td>Ventas mayoristas</td><td class="text-end" id="result-wholesale"><%= fin_money(wholesale.invoiced_cents) %></td></tr>
          <tr><td class="text-muted">(+)</td><td>Ventas minoristas</td><td class="text-end" id="result-retail"><%= fin_money(retail.invoiced_cents) %></td></tr>
          <tr class="fw-bold"><td class="text-muted">(=)</td><td>Total ventas</td><td class="text-end" id="result-sales"><%= fin_money(result.sales_cents) %></td></tr>
          <tr><td class="text-muted">(−)</td><td>Compras de mercadería</td><td class="text-end" id="result-purchases"><%= fin_money(result.purchases_cents) %></td></tr>
          <tr><td class="text-muted">(−)</td><td>Gastos generales</td><td class="text-end" id="result-expenses"><%= fin_money(result.expenses_cents) %></td></tr>
          <tr class="fw-bold"><td class="text-muted">(=)</td><td>Total compras y gastos</td><td class="text-end" id="result-costs"><%= fin_money(result.costs_cents) %></td></tr>
        </tbody>
      </table>
      <div class="finance-total d-flex flex-wrap justify-content-between align-items-baseline gap-2">
        <div>
          <div class="small text-muted">(=) Resultado simplificado</div>
          <div class="fs-3 fw-bold <%= fin_sign_class(result.result_cents) %>" id="result-total"><%= fin_money(result.result_cents) %></div>
        </div>
        <div class="text-end">
          <div class="small text-muted">(%) Sobre ventas</div>
          <div class="fs-4 fw-bold <%= fin_sign_class(result.result_cents) %>" id="result-margin"><%= fin_percent(result.result_margin) %></div>
        </div>
      </div>
      <% scale = [result.sales_cents, result.costs_cents].max %>
      <% if scale.positive? %>
        <div class="mt-3" aria-hidden="true">
          <div class="small text-muted">Ventas</div>
          <div class="finance-bar mb-1"><span class="finance-bar-sales" style="width: <%= (result.sales_cents * 100.0 / scale).round(1) %>%"></span></div>
          <div class="small text-muted">Compras y gastos</div>
          <div class="finance-bar"><span class="finance-bar-costs" style="width: <%= (result.costs_cents * 100.0 / scale).round(1) %>%"></span></div>
        </div>
      <% end %>
      <div class="small text-muted mt-3">
        Es un resultado <strong>simplificado</strong>, no la utilidad contable: compara lo facturado (por fecha de entrega) con las compras y gastos devengados del período. No refleja el costo de la mercadería efectivamente consumida ni la variación de inventario, impuestos no cargados ni amortizaciones.
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="product-card h-100 finance-highlight" id="cash-flow">
      <h2 class="fs-5 fw-bold mb-1">Flujo de caja</h2>
      <div class="small text-muted mb-3">Operativo parcial — <%= summary.period_label %></div>
      <table class="table table-sm align-middle mb-2 finance-statement">
        <tbody>
          <tr><td class="text-muted" style="width:2.5rem">(+)</td><td>Cobros mayoristas</td><td class="text-end" id="cash-wholesale"><%= fin_money(wholesale.collected_cents) %></td></tr>
          <tr><td class="text-muted">(+)</td><td>Cobros minoristas</td><td class="text-end" id="cash-retail"><%= fin_money(retail.collected_cents) %></td></tr>
          <tr class="fw-bold"><td class="text-muted">(=)</td><td>Total cobrado</td><td class="text-end text-success" id="cash-in"><%= fin_money(result.collected_cents) %></td></tr>
          <tr><td class="text-muted">(−)</td><td>Pagos a proveedores por compras</td><td class="text-end" id="cash-purchases"><%= fin_money(result.paid_purchases_cents) %></td></tr>
          <tr><td class="text-muted">(−)</td><td>Pagos de gastos generales</td><td class="text-end" id="cash-expenses"><%= fin_money(result.paid_expenses_cents) %></td></tr>
          <% if result.paid_advances_cents.nonzero? %>
            <tr><td class="text-muted">(−)</td><td>Anticipos a proveedores <span class="small text-muted">(aún sin imputar)</span></td><td class="text-end" id="cash-advances"><%= fin_money(result.paid_advances_cents) %></td></tr>
          <% end %>
          <tr class="fw-bold"><td class="text-muted">(=)</td><td>Total pagado</td><td class="text-end text-danger" id="cash-out"><%= fin_money(result.paid_cents) %></td></tr>
        </tbody>
      </table>
      <div class="finance-total">
        <div class="small text-muted">(=) Flujo neto</div>
        <div class="fs-3 fw-bold <%= fin_sign_class(result.net_cash_cents) %>" id="cash-net"><%= fin_money(result.net_cash_cents) %></div>
      </div>
      <div class="small text-muted mt-3">
        Todo por <strong>fecha efectiva</strong> de cobro o pago, sin anulados y contando cada pago una vez (aunque se reparta entre varias compras, gastos o pedidos). Es un flujo <strong>operativo parcial</strong>: solo incluye cobros de pedidos y pagos registrados en Administración; no incluye movimientos que no se cargan en HANS (retiros, aportes, préstamos, impuestos o comisiones no registrados como gasto).
      </div>
    </div>
  </div>
</div>
