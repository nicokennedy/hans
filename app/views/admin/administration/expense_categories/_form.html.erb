<%# locals: url, method, submit_label %>
<%= render "admin/administration/shared/errors", errors: @category.errors.full_messages %>
<%= form_with model: @category, scope: :expense_category, url: url, method: method, local: true do |f| %>
  <div class="product-card mb-4"><div class="row g-3">
    <div class="col-12 col-md-6"><%= f.label :name, "Nombre *", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true, maxlength: 100 %></div>
    <div class="col-6 col-md-3"><%= f.label :position, "Orden", class: "form-label" %><%= f.number_field :position, class: "form-control" %></div>
    <div class="col-6 col-md-3 d-flex align-items-end"><div class="form-check"><%= f.check_box :active, class: "form-check-input" %><%= f.label :active, "Activa", class: "form-check-label" %></div></div>
  </div></div>
  <div class="d-flex gap-2"><%= f.submit submit_label, class: "btn btn-dark" %><%= link_to "Cancelar", admin_administration_expense_categories_path, class: "btn btn-outline-dark" %></div>
<% end %>
