<%= form_with model: [:admin, @raw_material], local: true do |f| %>
  <% if @raw_material.errors.any? %>
    <div class="alert alert-danger">
      <%= @raw_material.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div class="product-card">
    <div class="mb-3">
      <%= f.label :name, "Nombre", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-12 col-md-4">
        <%= f.label :category, "Categoría", class: "form-label" %>
        <%= f.text_field :category, class: "form-control", placeholder: "Ej: Lácteos" %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.label :brand, "Marca", class: "form-label" %>
        <%= f.text_field :brand, class: "form-control" %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.label :supplier, "Proveedor", class: "form-label" %>
        <%= f.text_field :supplier, class: "form-control" %>
      </div>
    </div>

    <hr class="my-4">

    <p class="text-muted small mb-3">
      Cargá cómo la comprás — el costo normalizado (por <%= f.object.base_unit.presence || "unidad base" %>) se calcula solo, no se edita a mano.
    </p>

    <div class="row g-3 mb-3">
      <div class="col-12 col-md-4">
        <%= f.label :purchase_price_amount, "Precio de compra", class: "form-label" %>
        <%= f.number_field :purchase_price_amount, class: "form-control", min: 0, required: true %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.label :purchase_quantity, "Cantidad comprada", class: "form-label" %>
        <%= f.number_field :purchase_quantity, class: "form-control", min: 0, step: "any", required: true %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.label :purchase_unit, "Unidad de compra", class: "form-label" %>
        <%= f.select :purchase_unit, Admin::RawMaterialsHelper::UNIT_OPTIONS, { prompt: "Seleccionar" }, class: "form-select", required: true %>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <%= f.label :base_unit, "Unidad base de costeo", class: "form-label" %>
        <%= f.select :base_unit, Admin::RawMaterialsHelper::BASE_UNIT_OPTIONS, { prompt: "Seleccionar" }, class: "form-select", required: true %>
        <div class="form-text">Siempre kg, l o un — para que los costos sean comparables entre materias primas.</div>
      </div>

      <% if @raw_material.persisted? && @raw_material.unit_cost_cents.present? %>
        <div class="col-12 col-md-4">
          <div class="form-label">Costo normalizado actual</div>
          <div class="fw-bold"><%= format_money(@raw_material.unit_cost_cents) %>/<%= @raw_material.base_unit %></div>
        </div>
      <% end %>
    </div>

    <div class="form-check mb-4">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Activa", class: "form-check-label" %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "Guardar", class: "btn btn-dark" %>
      <%= link_to "Cancelar", admin_raw_materials_path, class: "btn btn-outline-dark" %>
    </div>
  </div>
<% end %>
