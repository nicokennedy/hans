<div class="container py-4">
  <p class="text-muted mb-1"><%= link_to "← Repartos", admin_delivery_routes_path %></p>
  <h1 class="mb-1">Rendiciones</h1>
  <p class="text-muted">Cada recorrido tiene su propia rendición. Las diferencias de caja se registran como diferencias, nunca como gastos.</p>

  <% if @overdue_routes.any? %>
    <div class="alert alert-warning">⚠ Sin rendición enviada de días anteriores:
      <%= safe_join(@overdue_routes.map { |r| link_to("#{l(r.date, format: '%d/%m')} · #{r.title}", admin_delivery_route_path(r, anchor: "rendicion")) }, ", ") %>
      · <%= link_to "Ver todas", settlements_admin_delivery_routes_path(filtro: "sin_enviar") %>
    </div>
  <% end %>

  <%= form_with url: settlements_admin_delivery_routes_path, method: :get, local: true, class: "row g-2 align-items-end mb-3" do %>
    <div class="col-6 col-md-3">
      <label class="form-label small" for="filtro">Estado</label>
      <%= select_tag :filtro, options_for_select(Admin::DeliveryRoutesController::FILTERS.invert, @filter), id: "filtro", class: "form-select form-select-sm" %>
    </div>
    <div class="col-6 col-md-3">
      <label class="form-label small" for="repartidor">Repartidor</label>
      <%= select_tag :repartidor, options_for_select(@drivers.map { |d| [d.display_name, d.id] }, @driver_id), include_blank: "Todos", id: "repartidor", class: "form-select form-select-sm" %>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="desde">Desde</label>
      <%= date_field_tag :desde, @from&.iso8601, id: "desde", class: "form-control form-control-sm" %>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small" for="hasta">Hasta</label>
      <%= date_field_tag :hasta, @to&.iso8601, id: "hasta", class: "form-control form-control-sm" %>
    </div>
    <div class="col-12 col-md-2"><%= submit_tag "Filtrar", name: nil, class: "btn btn-sm btn-dark w-100" %></div>
  <% end %>

  <% if @routes.empty? %>
    <p class="text-muted">No hay rendiciones en esta vista.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th>Fecha</th><th>Recorrido</th><th>Estado</th><th>Enviada</th><th class="text-end">Cobros</th><th class="text-end">Otros ingresos</th><th class="text-end">Gastos</th><th class="text-end">A entregar</th><th class="text-end">Recibido</th><th class="text-end">Diferencia</th><th>Avisos</th></tr></thead>
        <tbody>
          <% @routes.each do |route| %>
            <tr>
              <td><%= l(route.date, format: "%d/%m/%Y") %></td>
              <td><%= link_to route.title, admin_delivery_route_path(route, anchor: "rendicion") %> <span class="small text-muted">N.º <%= route.id %></span></td>
              <td><%= delivery_route_status_badge(route) %></td>
              <% live = @live[route.id] %>
              <td class="small"><%= route.submitted_at ? l(route.submitted_at, format: "%d/%m %H:%M") : "Sin enviar" %></td>
              <td class="text-end"><%= reparto_money(live ? live.collected_cents : route.collected_cents.to_i) %></td>
              <td class="text-end"><%= reparto_money(live ? live.other_income_cents : route.other_income_cents) %></td>
              <td class="text-end"><%= reparto_money(live ? live.expenses_cents : route.expenses_cents.to_i) %></td>
              <td class="text-end fw-bold"><%= reparto_money(live ? live.to_deliver_cents : [route.expected_cash_cents.to_i, 0].max) %></td>
              <td class="text-end"><%= route.confirmed? ? reparto_money(route.counted_cash_cents) : "—" %></td>
              <td class="text-end <%= 'text-danger fw-bold' if route.difference_cents.to_i.nonzero? %>"><%= route.confirmed? ? (route.difference_cents.to_i.zero? ? "$0" : "#{route.difference_cents.negative? ? 'Faltan' : 'Sobran'} #{reparto_money(route.difference_cents.abs)}") : "—" %></td>
              <td class="small">
                <% if route.unresolved_cents.to_i.positive? %><span class="badge text-bg-warning">Pendiente de resolver <%= reparto_money(route.unresolved_cents) %></span><% end %>
                <% if (n = @voided_after_close[route.id].to_i).positive? %><span class="badge text-bg-danger"><%= n %> cobro(s) anulado(s) después</span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="small text-muted">Los importes de una rendición enviada son los del envío; administración puede corregir antes de confirmar y el cierre recalcula.</p>
  <% end %>
</div>
