<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Clientes</h1>
      <p class="text-muted mb-0">Datos comerciales y accesos al portal.</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "← Admin", admin_root_path, class: "btn btn-outline-dark" %>
      <%= link_to "Nuevo cliente", new_admin_customer_path, class: "btn btn-dark" %>
    </div>
  </div>

  <%= render "period_filter" %>

  <div class="product-card mb-4">
    <h2 class="fs-5 fw-bold mb-3">Resumen del período (<%= @collections_period.label %>)</h2>

    <div class="row">
      <div class="col-6 col-md-3">
        <div class="text-muted small mb-1">Facturado</div>
        <div class="fw-bold fs-5">$<%= number_with_delimiter(@total_invoiced_cents / 100) %></div>
      </div>

      <div class="col-6 col-md-3">
        <div class="text-muted small mb-1">Cobrado</div>
        <div class="fw-bold fs-5">$<%= number_with_delimiter(@total_paid_cents / 100) %></div>
      </div>

      <div class="col-6 col-md-3">
        <div class="text-muted small mb-1">Pendiente</div>
        <div class="fw-bold fs-5">$<%= number_with_delimiter((@total_invoiced_cents - @total_paid_cents) / 100) %></div>
      </div>

      <div class="col-6 col-md-3">
        <div class="text-muted small mb-1">% Cobrado</div>
        <div class="fw-bold fs-5">
          <% percent = collections_percent(@total_invoiced_cents, @total_paid_cents) %>
          <%= percent.nil? ? "—" : "#{percent}%" %>
        </div>
      </div>
    </div>
  </div>

  <div class="product-card mb-4" id="customer-search">
    <%= form_with url: admin_customers_path, method: :get, local: true, role: "search" do %>
      <label for="customer-search-input" class="form-label">Buscar cliente</label>
      <div class="d-flex flex-column flex-sm-row gap-2">
        <%= search_field_tag :q, @search_query,
            id: "customer-search-input",
            class: "form-control",
            placeholder: "Nombre, contacto, email o teléfono",
            autocomplete: "off",
            maxlength: Customer::SEARCH_MAX_LENGTH,
            aria: { describedby: "customer-search-help" } %>
        <div class="d-flex gap-2">
          <%= submit_tag "Buscar", name: nil, class: "btn btn-dark flex-fill" %>
          <% if @search_query.present? %>
            <%= link_to "Limpiar", admin_customers_path, class: "btn btn-outline-dark flex-fill" %>
          <% end %>
        </div>
      </div>
      <div id="customer-search-help" class="form-text">
        <% if @search_query.present? %>
          <%= pluralize(@customers.size, "cliente encontrado", plural: "clientes encontrados") %> para «<%= @search_query %>».
        <% else %>
          Busca en todos los clientes, sin importar mayúsculas ni tildes.
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="product-card">
    <% if @customers.empty? %>
      <div class="text-center text-muted py-4" id="customers-empty">
        <% if @search_query.present? %>
          <p class="mb-2">No se encontraron clientes para «<%= @search_query %>».</p>
          <%= link_to "Limpiar búsqueda", admin_customers_path, class: "btn btn-sm btn-outline-dark" %>
        <% else %>
          Todavía no hay clientes.
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Negocio</th>
              <th>Contacto</th>
              <th>Email comercial</th>
              <th>Teléfono</th>
              <th>Email de acceso</th>
              <th>Estado</th>
              <th>Facturado</th>
              <th>Cobrado</th>
              <th>Saldo</th>
              <th>% Cobrado</th>
              <th>Estado de cuenta</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% @customers.each do |customer| %>
              <% access_user = customer.users.first %>
              <% invoiced = @invoiced_by_customer[customer.id].to_i %>
              <% paid = @paid_by_customer[customer.id].to_i %>
              <%# Toda la fila abre el detalle, igual que "Ver" (ver row_link_controller.js); los botones y enlaces de la fila siguen funcionando solos. %>
              <tr class="table-row-link" data-controller="row-link" data-row-link-url-value="<%= admin_customer_path(customer, customers_list_params) %>" data-action="click->row-link#visit auxclick->row-link#visit">
                <td class="fw-bold"><%= link_to customer.name, admin_customer_path(customer, customers_list_params), class: "text-decoration-none text-dark" %></td>
                <td><%= customer.contact_name.presence || "-" %></td>
                <td><%= customer.email.presence || "-" %></td>
                <td><%= customer.phone.presence || "-" %></td>
                <td><%= access_user&.email.presence || "Sin usuario" %></td>
                <td>
                  <% if customer.active? %>
                    <span class="badge bg-success">Activo</span>
                  <% else %>
                    <span class="badge bg-secondary">Inactivo</span>
                  <% end %>
                </td>
                <td>$<%= number_with_delimiter(invoiced / 100) %></td>
                <td>$<%= number_with_delimiter(paid / 100) %></td>
                <td>$<%= number_with_delimiter((invoiced - paid) / 100) %></td>
                <td>
                  <% customer_percent = collections_percent(invoiced, paid) %>
                  <%= customer_percent.nil? ? "—" : "#{customer_percent}%" %>
                </td>
                <td>
                  <% account_status = collections_status_label(invoiced, paid) %>
                  <% if account_status == "Al día" %>
                    <span class="badge bg-success">Al día</span>
                  <% elsif account_status == "Saldo pendiente" %>
                    <span class="badge bg-warning text-dark">Saldo pendiente</span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex justify-content-end gap-2">
                    <%= link_to "Cuenta corriente", admin_customer_account_path(customer), class: "btn btn-sm btn-dark" %>
                    <%= link_to "Ver", admin_customer_path(customer, customers_list_params), class: "btn btn-sm btn-outline-dark" %>
                    <%= link_to "Editar", edit_admin_customer_path(customer, customers_list_params), class: "btn btn-sm btn-outline-dark" %>
                    <%= button_to(
                      customer.active? ? "Desactivar" : "Reactivar",
                      toggle_active_admin_customer_path(customer),
                      method: :patch,
                      params: customers_list_params,
                      class: "btn btn-sm #{customer.active? ? 'btn-outline-danger' : 'btn-outline-success'}",
                      form: { data: { turbo_confirm: customer.active? ? "¿Desactivar el acceso de este cliente?" : nil } }
                    ) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
