<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Recetas</h1>
      <p class="text-muted mb-0">Estado del costeo por receta de cada producto — sin receta, en borrador, o activa.</p>
    </div>

    <%= link_to "← Admin", admin_root_path, class: "btn btn-outline-dark" %>
  </div>

  <div class="product-card">
    <% if @products.empty? %>
      <div class="p-4 text-center">
        <h2 class="h5">No hay productos cargados</h2>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Estado receta</th>
              <th>Rendimiento</th>
              <th>Costo calculado</th>
              <th>Costo actual del producto</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% @products.each do |product| %>
              <tr>
                <td class="fw-bold"><%= product.name %></td>
                <td><span class="badge <%= recipe_state_badge_class(product) %>"><%= recipe_state_label(product) %></span></td>
                <td>
                  <% if product.product_recipe.present? %>
                    <%= format_quantity(product.product_recipe.yield_quantity) %> un
                  <% else %>
                    —
                  <% end %>
                </td>
                <td>
                  <% if product.product_recipe.present? %>
                    <% _total_display, unit_display = product_recipe_cost_display(product.product_recipe) %>
                    <%= unit_display %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td><%= format_money(product.cost_cents) %></td>
                <td class="text-end">
                  <%= link_to recipe_action_label(product), recipe_action_path(product), class: "btn btn-sm btn-outline-dark" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
