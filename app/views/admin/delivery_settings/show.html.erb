<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Fechas de entrega</h1>
      <p class="text-muted mb-0">
        Días habituales: lunes, miércoles, viernes y sábado. Acá se administran fechas puntuales adicionales,
        sin cambiar esa regla general.
      </p>
    </div>

    <%= link_to "← Admin", admin_root_path, class: "btn btn-outline-dark" %>
  </div>

  <div class="product-card">
    <h2 class="h5">Fechas excepcionales de entrega</h2>
    <p class="text-muted small">
      Habilitá una fecha puntual aunque caiga en un día normalmente cerrado (ej. un martes o un jueves).
      No habilita ese día de la semana en general — solo esa fecha exacta. Sigue sin poder pedirse el mismo día.
    </p>

    <%= form_with url: admin_exceptional_delivery_dates_path, method: :post, local: true, html: { class: "row g-2 align-items-end mb-4" } do |f| %>
      <div class="col-12 col-md-4">
        <%= label_tag :date, "Fecha", class: "form-label" %>
        <%= date_field_tag :date, nil, class: "form-control", required: true, min: Date.current.iso8601 %>
      </div>
      <div class="col-12 col-md-3">
        <%= submit_tag "Habilitar fecha", class: "btn btn-dark" %>
      </div>
    <% end %>

    <% if @exceptional_dates.empty? %>
      <p class="text-muted mb-0">No hay fechas excepcionales habilitadas.</p>
    <% else %>
      <ul class="list-group">
        <% @exceptional_dates.each do |date| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= exceptional_date_label(date) %></span>

            <%= button_to "Deshabilitar",
              admin_exceptional_delivery_date_path(date.iso8601),
              method: :delete,
              class: "btn btn-sm btn-outline-danger",
              form: { class: "d-inline" },
              data: { turbo_confirm: "¿Deshabilitar #{exceptional_date_label(date)} como fecha de entrega?" } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
