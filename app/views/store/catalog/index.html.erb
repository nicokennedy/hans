<%# Orden: especialidades (arcos) → información comercial → categorías → catálogo. Sin portada. %>

<% if @categories.empty? %>
  <div class="store-container">
    <div class="store-empty" id="store-empty-catalog">
      <%= store_icon(:sparkle, size: 28) %>
      <h2>Estamos preparando la tienda</h2>
      <p>Todavía no hay productos publicados. Mientras tanto podés escribirnos por WhatsApp.</p>
    </div>
  </div>
  <%= render "store/catalog/perks", extra_class: "store-perks-standalone" %>

<% else %>
  <section class="store-categories" aria-labelledby="categorias-title">
    <div class="store-container">
      <div class="store-heading-row">
        <h2 class="store-display-title" id="categorias-title">Nuestras <em>especialidades</em></h2>
      </div>
      <ul class="store-category-tiles">
        <% @categories.each do |category, products| %>
          <% cover = products.find(&:purchasable?) || products.first %>
          <li>
            <a class="store-category-tile" href="#categoria-<%= category.id %>">
              <span class="store-category-photo"><%= store_photo_tag(cover.primary_photo, alt: "") %></span>
              <span class="store-category-name"><%= category.name %></span>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%= render "store/catalog/perks" %>

  <div id="productos" class="store-catalog">
    <nav class="store-chips-wrap" aria-label="Categorías">
      <div class="store-container">
        <div class="store-chips">
          <% if @featured.any? %><a class="store-chip" href="#destacados">Destacados</a><% end %>
          <% @categories.each do |category, _| %>
            <a class="store-chip" href="#categoria-<%= category.id %>"><%= category.name %></a>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="store-container">
      <% if @featured.any? %>
        <section class="store-section store-section-featured" id="destacados" aria-labelledby="destacados-title">
          <header class="store-section-head">
            <p class="store-eyebrow">Selección de la casa</p>
            <h2 class="store-featured-title" id="destacados-title">Destacados</h2>
          </header>
          <div class="store-grid">
            <% @featured.each do |product| %><%= render "store/shared/product_card", product: product %><% end %>
          </div>
        </section>
      <% end %>

      <% @categories.each do |category, products| %>
        <section class="store-section" id="categoria-<%= category.id %>" aria-labelledby="categoria-<%= category.id %>-title">
          <header class="store-section-head">
            <h2 class="store-section-title" id="categoria-<%= category.id %>-title"><%= category.name %></h2>
            <span class="store-section-count"><%= products.size %> <%= products.size == 1 ? "producto" : "productos" %></span>
          </header>
          <div class="store-grid">
            <% products.each do |product| %><%= render "store/shared/product_card", product: product %><% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
