<% content_for :title, @product.name %>
<% sizes = @product.ordered_variants.select(&:active?) %>
<% editing = @editing # caja del carrito que se está editando (variante + composición), o nil %>
<% selected = editing ? editing[:variant] : @product.display_variant %>
<% box = @product.customizable_content? %>
<div class="store-container store-product" id="store-product">
  <nav class="store-breadcrumb" aria-label="Ubicación">
    <%= link_to store_root_path(anchor: "productos") do %><%= store_icon(:arrow_left, size: 16) %> Tienda<% end %>
    <span aria-hidden="true">/</span>
    <%= link_to @product.retail_category.name, store_root_path(anchor: "categoria-#{@product.retail_category_id}") %>
  </nav>

  <div class="store-product-grid">
    <div class="store-gallery" data-controller="store-gallery">
      <div class="store-gallery-main <%= 'is-sold-out' unless @product.purchasable? %>">
        <% main = @photos.first %>
        <%= store_photo_tag(main, variant: :detail, alt: @product.name, loading: "eager", fetchpriority: "high", data: { store_gallery_target: "main" }) %>
        <% unless @product.purchasable? %><span class="store-badge store-badge-soldout">Agotado</span><% end %>
      </div>
      <% if @photos.size > 1 %>
        <div class="store-gallery-thumbs" role="list">
          <% @photos.each_with_index do |photo, index| %>
            <button type="button" role="listitem" class="store-gallery-thumb <%= 'is-active' if index.zero? %>" aria-label="Ver foto <%= index + 1 %> de <%= @photos.size %>"
                    data-action="store-gallery#show" data-store-gallery-target="thumb" data-src="<%= store_photo_url(photo, :detail) %>">
              <%= store_photo_tag(photo, variant: :thumb, alt: "") %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="store-product-info">
      <p class="store-eyebrow"><%= @product.retail_category.name %></p>
      <h1 class="store-product-name"><%= @product.name %></h1>
      <div data-controller="store-variant">
        <div class="store-product-price-row">
          <div class="store-product-price" id="store-product-price" data-store-variant-target="price" aria-live="polite"><%= store_money(selected.price_cents) %></div>
          <% if sizes.size > 1 %><span class="store-product-price-note" data-store-variant-target="label"><%= selected.label %></span><% end %>
        </div>
        <% if @product.description.present? %>
          <div class="store-product-description"><%= simple_format(@product.description) %></div>
        <% end %>
        <% sizes.each do |variant| %>
          <% next if variant.description.blank? %>
          <div class="store-product-description store-variant-description" id="variant-description-<%= variant.id %>" data-store-variant-target="description" data-variant-id="<%= variant.id %>" <%= "hidden" unless variant == selected %>>
            <% if sizes.size > 1 %><strong><%= variant.label %>:</strong><% end %>
            <%= simple_format(variant.description) %>
          </div>
        <% end %>

        <% if @product.purchasable? %>
          <% if editing %>
            <div class="store-box-editing" id="store-box-editing" role="status">Estás cambiando los sabores de una caja de tu carrito. <%= link_to "Volver al carrito", store_cart_path %></div>
          <% end %>
          <%= form_with url: (editing ? replace_item_store_cart_path : add_store_cart_path), method: (editing ? :patch : :post), class: "store-add-form", id: "store-add-form",
                data: (box ? { controller: "store-box", store_box_units_value: selected.content_units.to_i, action: "submit->store-box#guard" } : {}) do %>
            <%= hidden_field_tag :line, editing[:key], id: nil if editing %>
            <% if sizes.size > 1 %>
              <fieldset class="store-variants" id="store-variants">
                <legend class="store-label">Elegí <%= store_variant_kind(sizes) == "Tamaño" ? "el tamaño" : "la presentación" %></legend>
                <div class="store-variant-options store-variant-options-<%= [sizes.size, 4].min %>">
                  <% sizes.each do |variant| %>
                    <label class="store-variant-option <%= 'is-sold-out' unless variant.purchasable? %>">
                      <%= radio_button_tag :variant_id, variant.id, variant == selected, disabled: !variant.purchasable?, id: "variant-#{variant.id}",
                            data: { action: (box ? "store-variant#select change->store-box#variantChanged" : "store-variant#select"), price: store_money(variant.price_cents), label: variant.label,
                                    units: variant.content_units, max: [variant.stock_quantity || Retail::StoreCart::MAX_QUANTITY, Retail::StoreCart::MAX_QUANTITY].min } %>
                      <span class="store-variant-name"><%= variant.label %></span>
                      <span class="store-variant-price"><%= variant.purchasable? ? store_money(variant.price_cents) : "Agotado" %></span>
                    </label>
                  <% end %>
                </div>
              </fieldset>
            <% else %>
              <%= hidden_field_tag :variant_id, selected.id, id: nil %>
            <% end %>
            <% if box %>
              <%= render "store/catalog/box_builder", product: @product, selected: selected, quantities: editing ? editing[:quantities] : {} %>
            <% end %>
            <% if editing %>
              <button type="submit" class="store-btn store-btn-primary store-btn-lg w-100 store-add-submit" data-store-variant-target="submit" data-turbo-submits-with="Guardando…"><%= store_icon(:check, size: 20) %> Guardar los sabores</button>
            <% else %>
            <label class="store-label" for="quantity"><%= box ? "Cantidad de cajas" : "Cantidad" %></label>
            <div class="store-add-row">
              <div class="store-stepper" data-controller="store-quantity">
                <button type="button" class="store-stepper-btn" data-action="store-quantity#decrement" aria-label="Restar uno"><%= store_icon(:minus, size: 18) %></button>
                <%= number_field_tag :quantity, 1, min: 1, max: [selected.stock_quantity || Retail::StoreCart::MAX_QUANTITY, Retail::StoreCart::MAX_QUANTITY].min, step: 1, inputmode: "numeric", class: "store-stepper-input",
                      data: { store_quantity_target: "input", store_variant_target: "quantity" } %>
                <button type="button" class="store-stepper-btn" data-action="store-quantity#increment" aria-label="Sumar uno"><%= store_icon(:plus, size: 18) %></button>
              </div>
              <button type="submit" class="store-btn store-btn-primary store-btn-lg store-add-submit" data-store-variant-target="submit" data-turbo-submits-with="Agregando…"><%= store_icon(:bag, size: 20) %> Agregar al carrito</button>
            </div>
            <% end %>
          <% end %>

          <%# Celular: barra fija con precio y botón mientras el botón principal no está a la vista. %>
          <div class="store-buybar" data-store-variant-target="buybar" aria-hidden="true">
            <div class="store-buybar-info">
              <span class="store-buybar-name"><%= @product.name %></span>
              <span class="store-buybar-price" data-store-variant-target="price"><%= store_money(selected.price_cents) %></span>
            </div>
            <button type="submit" form="store-add-form" class="store-btn store-btn-primary" tabindex="-1"><%= editing ? "Guardar" : "Agregar" %></button>
          </div>
        <% else %>
          <div class="store-add-form store-sold-out" id="store-sold-out">
            <strong>Agotado por ahora.</strong> No se puede pedir por la tienda; escribinos por WhatsApp y te contamos cuándo vuelve.
            <%= link_to "https://wa.me/#{store_setting.whatsapp_number}", class: "store-btn store-btn-outline mt-3", target: "_blank", rel: "noopener noreferrer" do %>
              <%= store_whatsapp_icon(size: 18) %> Consultar por WhatsApp
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Los mismos mensajes comerciales de la banda de inicio y del pie (StoreHelper#store_info_messages). %>
      <%= render "store/shared/info_messages", list_class: "store-product-perks", icon_size: 18 %>
    </div>
  </div>
</div>
