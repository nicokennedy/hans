<% content_for :title, "Carrito" %>
<div class="store-container store-cart" id="store-cart">
  <header class="store-page-head">
    <p class="store-eyebrow">Paso 1 de 2</p>
    <h1 class="store-page-title">Tu carrito</h1>
  </header>

  <% if @dropped.any? %>
    <div class="store-flash store-flash-error" role="alert" id="store-cart-dropped">
      Sacamos del carrito <%= @dropped.to_sentence %> porque ya no <%= @dropped.size == 1 ? "está disponible" : "están disponibles" %>.
    </div>
  <% end %>

  <% if @lines.empty? %>
    <div class="store-empty" id="store-cart-empty">
      <span class="store-empty-icon"><%= store_icon(:bag, size: 30, stroke: 1.2) %></span>
      <h2>Tu carrito está vacío</h2>
      <p>Descubrí las tortas y dulces de HANS y armá tu pedido.</p>
      <%= link_to store_root_path(anchor: "productos"), class: "store-btn store-btn-primary store-btn-lg" do %>Ver productos <%= store_icon(:arrow_right, size: 18) %><% end %>
    </div>
  <% else %>
    <div class="store-cart-grid">
      <ul class="store-lines" aria-label="Productos del carrito">
        <% @lines.each do |line| %>
          <li class="store-line <%= 'is-added' if flash[:store_added] == line.variant.id.to_s %>" id="<%= dom_id(line.variant, :cart) %>">
            <%= link_to store_product_path_for(line.product), class: "store-line-photo", tabindex: -1, "aria-hidden": true do %>
              <%= store_photo_tag(line.product.primary_photo, variant: :thumb, alt: "") %>
            <% end %>
            <div class="store-line-main">
              <div class="store-line-head">
                <div>
                  <%= link_to line.product.name, store_product_path_for(line.product), class: "store-line-name" %>
                  <% if line.variant.name.present? %><div class="store-line-variant"><%= line.variant.name %></div><% end %>
                </div>
                <div class="store-line-total"><%= store_money(line.line_total_cents) %></div>
              </div>
              <div class="store-line-unit"><%= store_money(line.unit_price_cents) %> c/u</div>
              <% if line.short_stock? %><div class="store-line-warning"><%= Retail::OnlineStock::Insufficient.new(line.variant, line.variant.stock_quantity, line.quantity).message %></div><% end %>
              <div class="store-line-actions">
                <%= form_with url: update_item_store_cart_path, method: :patch, class: "store-line-qty", data: { controller: "store-quantity", store_quantity_autosubmit_value: true } do %>
                  <%= hidden_field_tag :variant_id, line.variant.id, id: nil %>
                  <div class="store-stepper store-stepper-sm">
                    <button type="button" class="store-stepper-btn" data-action="store-quantity#decrement" aria-label="Restar uno de <%= line.variant.full_name %>"><%= store_icon(:minus, size: 16) %></button>
                    <%= number_field_tag :quantity, line.quantity, min: 1, max: [line.variant.stock_quantity || Retail::StoreCart::MAX_QUANTITY, Retail::StoreCart::MAX_QUANTITY].min, step: 1, inputmode: "numeric", class: "store-stepper-input",
                          id: "qty-#{line.variant.id}", "aria-label": "Cantidad de #{line.variant.full_name}", data: { store_quantity_target: "input", action: "change->store-quantity#submit" } %>
                    <button type="button" class="store-stepper-btn" data-action="store-quantity#increment" aria-label="Sumar uno de <%= line.variant.full_name %>"><%= store_icon(:plus, size: 16) %></button>
                  </div>
                  <noscript><button type="submit" class="store-btn store-btn-outline store-btn-sm">Actualizar</button></noscript>
                <% end %>
                <%= button_to "Quitar", remove_item_store_cart_path, method: :delete, params: { variant_id: line.variant.id }, class: "store-link-btn", form_class: "d-inline" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>

      <aside class="store-summary store-summary-sticky" id="store-cart-summary" aria-label="Resumen">
        <h2 class="store-summary-title">Resumen</h2>
        <div class="store-summary-row store-summary-total"><span>Subtotal</span><strong id="store-cart-subtotal"><%= store_money(@lines.sum(&:line_total_cents)) %></strong></div>
        <p class="store-summary-note">El envío se calcula en el paso siguiente según la modalidad y la zona. El retiro por zona Plaza del Agua es gratis.</p>
        <%= link_to store_checkout_path, class: "store-btn store-btn-primary store-btn-lg w-100", id: "store-go-checkout" do %>Continuar con el pedido <%= store_icon(:arrow_right, size: 18) %><% end %>
        <%= link_to "Seguir comprando", store_root_path(anchor: "productos"), class: "store-btn store-btn-ghost w-100 mt-2" %>
        <p class="store-summary-trust"><%= store_icon(:chat, size: 16) %> Confirmamos tu pedido por WhatsApp antes de prepararlo.</p>
      </aside>
    </div>
  <% end %>

  <% if (last = Array(session[Store::CheckoutsController::PLACED_KEY]).last) %>
    <p class="text-center mt-4 small"><%= link_to "Ver tu último pedido", store_order_path(last), class: "store-muted" %></p>
  <% end %>
</div>
